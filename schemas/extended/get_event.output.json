{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcpwp:0.1:extended:get_event:output",
  "title": "get_event output",
  "description": "Full details of one event.",
  "type": "object",
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "not_found",
        "invalid_request",
        "unauthorized",
        "forbidden",
        "rate_limited",
        "unavailable",
        "internal_error"
      ],
      "description": "Outcome of the call. See SPECIFICATION.md section 10."
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "url": {
      "$ref": "#/$defs/https_url"
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "description": "RFC 3339 with offset.",
      "pattern": "(?:[Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:[Zz]|[+-][0-9]{2}:[0-9]{2})(?![\\s\\S])"
    },
    "timezone": {
      "type": "string",
      "description": "IANA time zone, e.g. America/Vancouver."
    },
    "event_status": {
      "type": "string",
      "enum": [
        "scheduled",
        "postponed",
        "rescheduled",
        "cancelled",
        "sold_out",
        "completed"
      ],
      "description": "Event lifecycle, independent of the call outcome."
    },
    "location": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "online",
            "in_person",
            "hybrid"
          ]
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "organizer": {
      "type": "string"
    },
    "price": {
      "type": "object",
      "description": "Indicative public pricing. Omit if not published.",
      "properties": {
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "ISO 4217 code."
        },
        "unit": {
          "type": "string",
          "description": "e.g. 'per day', 'per seat', 'one-time'."
        },
        "text": {
          "type": "string",
          "description": "Free-text price, e.g. 'From $5,000' or 'Contact for quote'."
        }
      }
    },
    "registration_url": {
      "$ref": "#/$defs/https_url"
    },
    "offering_id": {
      "type": "string",
      "description": "Related offering id from get_services."
    },
    "transaction_types": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "content_format": {
      "$ref": "#/$defs/content_format"
    },
    "content": {
      "type": "string"
    },
    "speakers": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Person ids or names."
    },
    "ext": {
      "$ref": "#/$defs/ext"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "required": [
          "id",
          "name",
          "url",
          "start",
          "content",
          "content_format"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "not_found",
              "invalid_request",
              "unauthorized",
              "forbidden",
              "rate_limited",
              "unavailable",
              "internal_error"
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    }
  ],
  "$defs": {
    "content_format": {
      "type": "string",
      "enum": [
        "text/markdown",
        "text/plain"
      ],
      "description": "Media type of the content field."
    },
    "error": {
      "type": "object",
      "description": "Present when status is an error status.",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string",
          "description": "Human-readable explanation."
        },
        "retry_after_seconds": {
          "type": "integer",
          "minimum": 0,
          "description": "For rate_limited/unavailable: when the client may retry."
        }
      }
    },
    "ext": {
      "type": "object",
      "description": "Site-specific extension fields. Clients MUST ignore members they do not understand."
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://",
      "description": "Absolute HTTPS URL."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "description": "Stable identifier, unique within its collection on this site."
    }
  }
}
